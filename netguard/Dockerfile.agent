# مرحلة 1: بناء لوحة التحكم TypeScript
FROM node:20-alpine AS web
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci || npm install
COPY web/ ./
RUN npm run build

# مرحلة 2: بناء وكيل Go مع تضمين اللوحة
FROM golang:1.22-alpine AS build
WORKDIR /src/agent
COPY agent/ ./
COPY --from=web /src/web/dist ./internal/web/dist
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/netguard ./cmd/netguard

# مرحلة 3: الصورة النهائية (تحتاج أمر ping من iputils)
FROM alpine:3.20
RUN apk add --no-cache ca-certificates iputils-ping tzdata
COPY --from=build /out/netguard /netguard
COPY config.example.json /config.json
EXPOSE 8080
ENTRYPOINT ["/netguard", "-config", "/config.json"]
